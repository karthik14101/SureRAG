# =============================================================================
# SURE-GraphRAG configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in ONE LLM API key.
#     Windows PowerShell:  Copy-Item .env.example .env
#     macOS / Linux:       cp .env.example .env
# Everything else already has a working default for local development.
# =============================================================================
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# -----------------------------------------------------------------------------
# 1. LLM PROVIDER  --  flip this one line to switch the whole app over
# -----------------------------------------------------------------------------
# "gemini" = Google AI Studio  |  "groq" = GroqCloud  |  "azure" = Azure OpenAI / Foundry
# "ollama" = local Ollama server     |  "huggingface" = local transformers model
LLM_PROVIDER=gemini

# --- Google AI Studio (free key: https://aistudio.google.com/app/apikey) ------
GEMINI_API_KEY=
# Free-tier chat model. Verify the exact id in AI Studio -> Models if this 404s;
# good alternatives: gemini-2.5-flash, gemini-3-flash-lite
GEMINI_MODEL=gemini-2.5-flash
# Used for reading/captioning uploaded images and extracted figures.
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- GroqCloud (free key: https://console.groq.com/keys) ----------------------
GROQ_API_KEY=
# NOTE (2026): deepseek-r1-distill-llama-70b was retired, and
# llama-3.3-70b-versatile is enterprise-tier only. gpt-oss-120b is the
# recommended free/developer default. Fast+cheap alternative: llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b
# Groq currently ships no vision model. With LLM_PROVIDER=groq, image
# understanding falls back to local OCR (see OCR_ENABLED below).

# --- Azure OpenAI / Azure AI Foundry -----------------------------------------
# Needs three values. Find them in the Foundry portal under your deployment:
#   AZURE_OPENAI_ENDPOINT   - paste it as shown. A bare endpoint
#                             (https://your-resource.openai.azure.com) and a full
#                             "Target URI" (.../openai/deployments/<name>/chat/
#                             completions?api-version=...) both work -- the host
#                             is kept, and the deployment name is read out of it.
#   AZURE_OPENAI_API_KEY    - "Key 1" from the resource's Keys and Endpoint page.
#   AZURE_OPENAI_DEPLOYMENT - the DEPLOYMENT name you chose, not the model name.
#                             Optional if it is already inside a pasted Target URI.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# v1 = Azure's always-latest API, no monthly version to track (recommended).
# Only set a dated value (e.g. 2025-04-01-preview) for a resource that predates
# v1 support; that switches to the legacy api-version routing.
AZURE_OPENAI_API_VERSION=v1
# Reasoning deployments (GPT-5, o1/o3/o4) reject max_tokens and temperature.
#   auto  = guess from the deployment name, then adapt to what Azure accepts
#   true  = force reasoning mode    false = force a classic chat model
AZURE_OPENAI_REASONING=auto
# How hard a reasoning deployment thinks: minimal | low | medium | high.
# low keeps routing and verification calls fast and cheap.
AZURE_OPENAI_REASONING_EFFORT=low
# gpt-4o / gpt-4.1 / gpt-5 accept images. Set false for a text-only deployment;
# image captioning then falls back to local OCR. Auto-disables if rejected.
AZURE_OPENAI_VISION=true

# --- Ollama (local, free, no key) ---------------------------------------------
# 1. Install Ollama from https://ollama.com  (it runs as a background service)
# 2. Pull a model:   ollama pull qwen2.5:7b
# 3. Set LLM_PROVIDER=ollama
# Good choices: qwen2.5:7b (strong at JSON, ~5 GB) | llama3.1:8b | qwen3:8b
#               llama3.2:3b or qwen2.5:3b (fast on CPU-only laptops)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional model that can see images, for captioning uploads and PDF figures,
# e.g. gemma3:4b, llava:7b, qwen2.5vl:7b. Empty = OLLAMA_MODEL, if it has vision.
OLLAMA_VISION_MODEL=
# auto = ask Ollama whether the model supports images | true | false
OLLAMA_VISION=auto
# Context window in tokens. Ollama's own default is too small for RAG prompts.
OLLAMA_NUM_CTX=8192
# How long the model stays loaded after a call ("30m", "-1" = forever).
OLLAMA_KEEP_ALIVE=30m
# Thinking models (qwen3, deepseek-r1): false = answer directly (much faster).
# Also: true | low | medium | high (gpt-oss) | auto (model default)
OLLAMA_THINK=false
# Only for a password-protected remote Ollama / proxy.
OLLAMA_API_KEY=

# --- HuggingFace transformers (local, in-process, no server) -----------------
# Any chat model repo id from huggingface.co, or a local folder path. Weights
# download once into .hf_cache. Set LLM_PROVIDER=huggingface.
# CPU-friendly: Qwen/Qwen2.5-0.5B-Instruct | Qwen/Qwen2.5-1.5B-Instruct
#               HuggingFaceTB/SmolLM2-1.7B-Instruct | microsoft/Phi-3.5-mini-instruct
# GPU:          Qwen/Qwen2.5-7B-Instruct | meta-llama/Llama-3.1-8B-Instruct (gated)
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# auto = cuda -> mps -> cpu | cpu | cuda | cuda:1 | mps
HF_DEVICE=auto
# auto = bf16/fp16 on GPU, fp32 on CPU | float32 | float16 | bfloat16
HF_DTYPE=auto
# Only for gated models (Llama, Gemma): accept the licence on the model page,
# then paste a read token from https://huggingface.co/settings/tokens
HF_TOKEN=
# Prompt budget in tokens; longer prompts are trimmed from the middle.
HF_MAX_INPUT_TOKENS=8192
# 4-bit on an NVIDIA GPU. Needs: pip install bitsandbytes accelerate
HF_LOAD_IN_4BIT=false
HF_TRUST_REMOTE_CODE=false
HF_THINKING=false

# Local models are slow, especially on CPU. With LLM_PROVIDER=ollama or
# huggingface these replace LLM_TIMEOUT_SECONDS, and AGENT_TIMEOUT_SECONDS is
# raised to at least LOCAL_AGENT_TIMEOUT_SECONDS. Tip: GRAPH_EXTRACTION=off
# makes ingestion much faster with a local model (one LLM call per chunk saved).
LOCAL_LLM_TIMEOUT_SECONDS=600
LOCAL_AGENT_TIMEOUT_SECONDS=300

# Shared generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# 2. EMBEDDINGS  --  100% free, runs locally on CPU
# -----------------------------------------------------------------------------
# Downloads ~90 MB from HuggingFace on first launch. This is normal, not a hang.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
# "cpu" or "cuda". Leave as cpu unless you installed a CUDA build of torch.
EMBEDDING_DEVICE=cpu

# Optional local cross-encoder reranker. Big precision win, ~80 MB extra download,
# adds ~0.3s per query on CPU. Set to true once everything else works.
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=8

# Sparse (keyword/BM25) half of hybrid search, via fastembed. Downloads a few MB.
# If fastembed is missing or fails, the engine silently degrades to dense-only.
SPARSE_ENABLED=true

# -----------------------------------------------------------------------------
# 3. DATABASES  --  defaults match docker-compose.yml
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sure_chunks

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sureGraph2024
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# 4. RETRIEVAL + AGENT TUNING
# -----------------------------------------------------------------------------
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=150
RETRIEVAL_TOP_K=12
GRAPH_MAX_HOPS=2
GRAPH_SEED_ENTITIES=6

# The SURE evidence-sufficiency gate. Below this score the agent runs a query
# expansion pass instead of answering from weak context. 0.0 - 1.0
SURE_THRESHOLD=0.65
# Hard safety caps so the agentic loop can never run away.
AGENT_MAX_ITERATIONS=2
AGENT_MAX_LLM_CALLS=6
AGENT_TIMEOUT_SECONDS=45

# Knowledge-graph building during ingestion:
#   selective = only entity-dense chunks get an LLM call (recommended, ~60% cheaper)
#   on        = every chunk (slowest, richest graph)
#   off       = no graph; GRAPH queries fall back to vector search
GRAPH_EXTRACTION=selective

# -----------------------------------------------------------------------------
# 5. INGESTION LIMITS & SAFETY
# -----------------------------------------------------------------------------
MAX_UPLOAD_MB=100
MAX_ZIP_DEPTH=3
MAX_ZIP_ENTRIES=500
MAX_ZIP_UNCOMPRESSED_MB=500
INGEST_CONCURRENCY=2
MIN_IMAGE_PIXELS=64

# Local OCR for images and scanned pages. Requires the Tesseract BINARY to be
# installed separately (see README Step 0.4) - `pip install pytesseract` alone is
# not enough. Auto-detected: if the binary is missing this silently turns off.
OCR_ENABLED=true
# Only needed if Tesseract is not on your PATH, e.g.:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# -----------------------------------------------------------------------------
# 6. APP / SERVER
# -----------------------------------------------------------------------------
# Bind address. 127.0.0.1 keeps the server on this machine only (recommended).
# Use 0.0.0.0 only if you want to reach it from another device on your network.
# Note: 0.0.0.0 is a "listen on every interface" wildcard, NOT an address you can
# open in a browser -- browse to http://127.0.0.1:8000 either way.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SESSION_TTL_HOURS=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
# Keep the HuggingFace model cache inside the project instead of your home dir.
HF_HOME=./.hf_cache
